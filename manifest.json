{
  "manifest_version": 3,
  "name": "Скачать видео",
  "version": "1.8.3",
  "description": "Находит видео на странице и сохраняет его на компьютер в формате MP4 одной кнопкой.",
  "permissions": ["webRequest", "storage", "tabs", "downloads", "downloads.open", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["hls.js", "mp4.js", "background.js"] },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скачать видео",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "video-grabber@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
